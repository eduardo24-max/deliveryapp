# VelozEat backend
PORT=3100
VELOZEAT_SECRET=cambia-esto-en-produccion
ADMIN_EMAIL=admin@velozeat.com
ADMIN_PASSWORD=admin123
VELOZEAT_DATA_FILE=./data.json

# WhatsApp Business API (Meta Cloud API)
# Obtener en https://developers.facebook.com -> tu App -> WhatsApp -> API Setup
WHATSAPP_TOKEN=EAAxxxx...
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_VERIFY_TOKEN=velozeat-verify
WHATSAPP_API_VERSION=v20.0
# Opcional: secreto de la app para validar la firma del webhook
WHATSAPP_APP_SECRET=
# Número del dueño/admin para recibir alertas (formato internacional sin +)
WHATSAPP_ADMIN_PHONE=521555000000
WHATSAPP_DEFAULT_COUNTRY_CODE=52
SUPPORT_PHONE=521555000000