# ============================================
# Copia este archivo a ".env" y llena tus datos
# ============================================

# --- Email (Gmail) para enviar códigos y notificaciones ---
# ADMIN_EMAIL: tu correo (el que envía y recibe)
# EMAIL_PASSWORD: tu "contraseña de aplicación" de Gmail (NO es tu contraseña normal)
ADMIN_EMAIL=medinahernandezeduardo73@gmail.com
EMAIL_PASSWORD=TU_CONTRASENA_APP_GMAIL

# --- Contraseña del panel de administración (/admin) ---
ADMIN_PASSWORD=tu_contrasena_admin

# --- Puerto ---
PORT=3000

# --- Frontend (para producción pon la URL pública) ---
FRONTEND_URL=http://localhost:3000

# --- Supabase (base de datos en la nube - OPCIONAL pero recomendado) ---
# Deja estas 2 líneas vacías para usar database.json local.
# En producción pon aquí los valores de tu proyecto Supabase.
# SUPABASE_URL=
# SUPABASE_KEY=
